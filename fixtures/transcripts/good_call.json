{
  "id": "good_call",
  "scenarioId": "vanaema-insult",
  "segments": [
    {
      "speaker": "dispatcher",
      "startMs": 300,
      "endMs": 1100,
      "text": "Häirekeskus kuuleb, mis juhtus?"
    },
    {
      "speaker": "caller",
      "startMs": 1300,
      "endMs": 3600,
      "text": "Tere, mu vanaema hakkas äkki segaselt rääkima, ta ei leia sõnu."
    },
    {
      "speaker": "dispatcher",
      "startMs": 4000,
      "endMs": 4600,
      "text": "Mis aadressil te olete?"
    },
    {
      "speaker": "caller",
      "startMs": 4800,
      "endMs": 6300,
      "text": "Männikäbi tee 14, Haabneeme, Viimsi vald."
    },
    {
      "speaker": "dispatcher",
      "startMs": 6700,
      "endMs": 7800,
      "text": "Kordan: Männikäbi tee 14, Haabneeme. Kas õige?"
    },
    {
      "speaker": "caller",
      "startMs": 8000,
      "endMs": 8300,
      "text": "Jah, õige."
    },
    {
      "speaker": "dispatcher",
      "startMs": 8600,
      "endMs": 9700,
      "text": "Kui vana ta on ja kas ta on teadvusel?"
    },
    {
      "speaker": "caller",
      "startMs": 9900,
      "endMs": 11800,
      "text": "Ta on 78, teadvusel, istub laua taga, aga jutt on täiesti segane."
    },
    {
      "speaker": "dispatcher",
      "startMs": 12200,
      "endMs": 12800,
      "text": "Kas ta hingab normaalselt?"
    },
    {
      "speaker": "caller",
      "startMs": 13000,
      "endMs": 13400,
      "text": "Jah, hingab."
    },
    {
      "speaker": "dispatcher",
      "startMs": 13900,
      "endMs": 14500,
      "text": "Millal see algas?"
    },
    {
      "speaker": "caller",
      "startMs": 14700,
      "endMs": 15500,
      "text": "Umbes viis minutit tagasi."
    },
    {
      "speaker": "dispatcher",
      "startMs": 16200,
      "endMs": 19300,
      "text": "Kiirabi on teie poole teel. Jääge tema juurde ja tehke välisuks lahti. Öelge mulle kohe, kui midagi muutub."
    },
    {
      "speaker": "caller",
      "startMs": 19000,
      "endMs": 21500,
      "text": "Oodake, nüüd ta suunurk vajus viltu ja ta ei saa paremat kätt tõsta!"
    },
    {
      "speaker": "dispatcher",
      "startMs": 22000,
      "endMs": 24500,
      "text": "Selge, annan selle kiirabile edasi. Kas ta on endiselt teadvusel?"
    },
    {
      "speaker": "caller",
      "startMs": 24800,
      "endMs": 25200,
      "text": "Jah, on."
    },
    {
      "speaker": "dispatcher",
      "startMs": 28500,
      "endMs": 30000,
      "text": "Kiirabi on kohal. Võite kõne lõpetada."
    }
  ],
  "toolCalls": [
