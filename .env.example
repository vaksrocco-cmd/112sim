# Kopeeri see fail nimega .env.local ja täida. .env.local ei lähe kunagi GitHubi.
# Võtmeid jagatakse privaatselt (mitte GitHubis ega grupivestluses).

# Claude API (platform.claude.com -> API keys). Ainult serveris, MITTE NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# Häälepakkuja brauseris: mock | cascade | elevenlabs (URL-is saab üle kirjutada: ?voice=mock)
NEXT_PUBLIC_VOICE_PROVIDER=mock

# Kõnesüntees (Sander valib). tartunlp | elevenlabs | browser
TTS_PROVIDER=browser
TARTUNLP_SPEAKER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Valikuline parem kõnetuvastus
SONIOX_API_KEY=

# Supabase (kui tühi, hoitakse sessioone serveri mälus)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
