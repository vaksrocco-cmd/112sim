# Kopeeri see fail nimega .env.local ja täida. .env.local ei lähe kunagi GitHubi.
# Võtmeid jagatakse privaatselt (mitte GitHubis ega grupivestluses).

# OpenAI API (platform.openai.com -> API keys). Ainult serveris, MITTE NEXT_PUBLIC_.
# OpenAI teeb kõik otsused: päästekorraldaja, kohtunik, analüütik.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-6.1-terra      # kohtunik ja päästekorraldaja (odavam: gpt-6-luna)
OPENAI_SMART_MODEL=gpt-6.1-sol       # analüütik
OPENAI_FAST_REASONING_EFFORT=        # valikuline, nt low (kiirem vastus)

# Groq API (console.groq.com -> API Keys, tasuta tase). Ainult serveris.
# Ainult eestikeelne kõnetuvastus (Whisper). LLM-ina Groqi ei kasutata.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Häälepakkuja brauseris: mock | cascade | openai (URL-is saab üle kirjutada: ?voice=cascade)
# cascade = mikrofon -> Groq Whisper -> OpenAI -> TartuNLP kõnesüntees
NEXT_PUBLIC_VOICE_PROVIDER=mock

# Päästekorraldaja hääl (kõnesüntees): tartunlp (tasuta avalik API, eesti keel, võtit pole vaja) | browser
# Groqi kõnesüntees eesti keelt ei oska (ainult inglise ja araabia).
TTS_PROVIDER=tartunlp
TARTUNLP_SPEAKER=mari

# Valikuline: OpenAI Realtime hääl (?voice=openai), kui Sander selle valmis teeb
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin

# Supabase (kui tühi, hoitakse sessioone serveri mälus)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
