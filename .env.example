# Kopeeri see fail nimega .env.local ja täida. .env.local ei lähe kunagi GitHubi.
# Võtmeid jagatakse privaatselt (mitte GitHubis ega grupivestluses).

# OpenAI API (platform.openai.com -> API keys). Ainult serveris, MITTE NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-6.1-terra      # kohtunik ja kaskaadi päästekorraldaja (odavam: gpt-6-luna)
OPENAI_SMART_MODEL=gpt-6.1-sol       # analüütik
OPENAI_FAST_REASONING_EFFORT=        # valikuline, nt low (kiirem vastus)
REALTIME_MODEL=gpt-realtime-2.1      # häälkõne (odavam: gpt-realtime-2.1-mini)
REALTIME_VOICE=marin                 # vali hääletestis, milline kõlab eesti keeles kõige paremini

# Häälepakkuja brauseris: mock | openai | cascade | elevenlabs (URL-is saab üle kirjutada: ?voice=mock)
NEXT_PUBLIC_VOICE_PROVIDER=mock

# Varuvalikud (kaskaad): kõnesüntees tartunlp | elevenlabs | browser
TTS_PROVIDER=browser
TARTUNLP_SPEAKER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SONIOX_API_KEY=

# Supabase (kui tühi, hoitakse sessioone serveri mälus)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
